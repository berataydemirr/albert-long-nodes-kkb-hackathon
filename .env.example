# Copy this file to .env and fill in real values.
# .env is never committed to git (see .gitignore).

# TCMB EVDS API key - obtained by registering at evds.tcmb.gov.tr
EVDS_API_KEY=

# TUIK Data Portal API key - obtained by creating an account at
# veriportali.tuik.gov.tr and verifying your phone number via SMS
# on the "User Information" screen
TUIK_API_KEY=

# MIA / Kloudeks API key. Never commit the real value.
MIA_API_KEY=
MIA_BASE_URL=https://mia.csp.kloudeks.com/v1
MIA_CHAT_MODEL=kkbhackathon2026/Qwen3.8-27B
MIA_EMBEDDING_MODEL=kkbhackathon2026/Qwen3-Embedding-8B

# "duckduckgo" needs no setup but is blocked (bot challenge) from some
# networks. For working search, run `docker compose -f docker-compose.searxng.yml
# up -d` and set WEB_SEARCH_PROVIDER=searxng - open-source, no API key,
# no request quota. See README's "Web search" section.
WEB_SEARCH_PROVIDER=duckduckgo
SEARXNG_BASE_URL=http://localhost:8888

# Optional language passed to the local Tesseract binary for image URLs.
WEB_URL_OCR_LANG=eng

# Deployment context budget (set to your provider's supported limit).
# Harness calls compact above 80% of input capacity, including tool schemas.
AGENT_CONTEXT_TOKENS=16384
AGENT_OUTPUT_RESERVE_TOKENS=2048
