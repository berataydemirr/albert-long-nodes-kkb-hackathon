.env
venv/
.venv/
__pycache__/
*.pyc
.claude/

# Runtime output - regeneratable, ignored so the repo doesn't bloat
logs/*.log
data/bronze/
data/debug/
data/gold/*.duckdb
data/uploads/

# Keep the folder skeleton (.gitkeep)
!logs/.gitkeep
!data/gold/.gitkeep

# Local-only reference material, not part of the public repo
CONTRIBUTING.md
archive/

# Private real-world test Excel/PDF files the user drops in for adversarial
# benchmarking - never committed, never named in README or commit messages.
# The report is ignored too - it quotes real numbers/answers derived from
# those private files, so it is exactly as sensitive as the files themselves.
test_excels/
EVDS_16-09-2026.xlsx
benchmarks/adversarial_excel_benchmark_report.json
