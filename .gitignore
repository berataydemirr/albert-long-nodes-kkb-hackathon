.env
venv/
.venv/
__pycache__/
*.pyc
.claude/

# Runtime output - regeneratable, ignored so the repo doesn't bloat
logs/*.log
data/bronze/
data/debug/
data/gold/*.duckdb
data/uploads/

# Keep the folder skeleton (.gitkeep)
!logs/.gitkeep
!data/gold/.gitkeep

# Local-only reference material, not part of the public repo
CONTRIBUTING.md
archive/

# test_excels/ used to be private-by-default here; the 5 real public TCMB
# EVDS files it now holds (see test_excels/README.md) are deliberately
# tracked and no longer ignored - they are real, public TCMB statistical
# exports, not personal/proprietary data. A NEW file dropped in here that
# should stay private (an actual personal/unverified upload) needs its own
# explicit ignore line below, same as EVDS_16-09-2026.xlsx did.
EVDS_16-09-2026.xlsx

# Local-only mentor notes - copy/paste reference, never committed/pushed/shared
MENTOR_NOTLARI_teknik_mimari_ozet.md

# Tesseract OCR language data (~8MB of binary model files) - see
# src/agent/pdf_import.py's own comment for how to populate this locally.
tessdata/
